---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-brand">
    <strong>Natt!</strong>
    <span>Psicóloga • CRP 08/49156</span>
  </div>

  <nav class="footer-links" aria-label="Navegação do rodapé">
    <a href="#quem-sou">Quem sou</a>
    <a href="#abordagem">Como trabalho</a>
    <a href="#reflexoes">Reflexões</a>
    <a href="#contato">Contato</a>
  </nav>

  <p>© {year} Natalia Veber</p>
</footer>

<style>
  .site-footer {
    padding: 2.2rem 6%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    background: #254e82;
    color: #f8f1e4;
    border-top: 1px solid rgba(248, 241, 228, 0.18);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-brand strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.6rem;
  }

  .footer-brand span,
  .site-footer p,
  .footer-links a {
    font-size: 0.78rem;
  }

  .footer-brand span {
    color: #f5edc8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    gap: 1.4rem;
  }

  .footer-links a {
    color: #f8f1e4;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #f5edc8;
  }

  .site-footer p {
    margin: 0;
    text-align: right;
    opacity: 0.75;
  }

  @media (max-width: 760px) {
    .site-footer {
      grid-template-columns: 1fr;
      gap: 1.4rem;
      padding: 2.5rem 7%;
    }

    .footer-links {
      flex-wrap: wrap;
      gap: 0.9rem 1.2rem;
    }

    .site-footer p {
      text-align: left;
    }
  }
</style>
